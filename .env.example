CHAT_PROVIDER=ollama
API_PREFIX=/api/v1
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_REASONING=false
OLLAMA_KEEP_ALIVE=15m
OLLAMA_TIMEOUT_SECONDS=20
# Optional lightweight, non-reasoning model for the off-topic redirect only.
# qwen3 reasons in-content and often falls back; a small instruct model lands
# the playful redirect reliably. Free-form redirects are disabled by default so
# ordinary deployments do not load a second model for cosmetic responses.
OLLAMA_OFFTOPIC_ENABLED=false
OLLAMA_OFFTOPIC_MODEL=llama3.2:3b

# Optional hosted alternative:
# CHAT_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

MAX_TURNS_PER_SESSION=20
SESSION_TTL_SECONDS=1800
MAX_ACTIVE_SESSIONS=1000
MAX_HISTORY_MESSAGES=16
MAX_MESSAGE_CHARS=2000
LIMIT_WARNING_THRESHOLD=3
